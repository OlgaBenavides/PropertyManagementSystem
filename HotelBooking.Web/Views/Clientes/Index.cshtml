@model List<Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Clientes</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="@Url.Action("Create")" class="btn btn-primary">Crear Cliente</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <form method="get" action="@Url.Action("Buscar")" class="d-flex gap-2">
                <input type="text" name="identificacion" class="form-control" placeholder="Buscar por identificación..." required />
                <button type="submit" class="btn btn-secondary">Buscar</button>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Primer Apellido</th>
                    <th>Segundo Apellido</th>
                    <th>Fecha Nacimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Identificacion</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.PrimerApellido</td>
                        <td>@cliente.SegundoApellido</td>
                        <td>@cliente.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = cliente.Identificacion })" class="btn btn-sm btn-warning">Editar</a>
                            <a href="@Url.Action("Delete", new { id = cliente.Identificacion })" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No hay clientes registrados.
        </div>
    }
</div>
