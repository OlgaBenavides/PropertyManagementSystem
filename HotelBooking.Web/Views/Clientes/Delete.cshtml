@model Cliente

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<h2>Eliminar Cliente</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Identificación</dt>
            <dd class="col-sm-9">@Model?.Identificacion</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model?.Nombre</dd>

            <dt class="col-sm-3">Primer Apellido</dt>
            <dd class="col-sm-9">@Model?.PrimerApellido</dd>

            <dt class="col-sm-3">Segundo Apellido</dt>
            <dd class="col-sm-9">@Model?.SegundoApellido</dd>

            <dt class="col-sm-3">Fecha de nacimiento</dt>
            <dd class="col-sm-9">@Model?.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
        </dl>

        <p class="text-danger">¿Está seguro que desea eliminar este cliente?</p>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Identificacion" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
        </form>
    </div>
</div>
