@model List<Empleado>

<h2>Empleados</h2>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-success">Crear nuevo empleado</a>

    <form asp-action="Buscar" method="get" class="d-flex" role="search">
        <input type="text" name="identificacion" class="form-control me-2" placeholder="Buscar por identificación" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </form>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Primer Apellido</th>
            <th>Segundo Apellido</th>
            <th>Categoria</th>
            <th>Salario Mensual</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Identificacion</td>
                <td>@item.Nombre</td>
                <td>@item.PrimerApellido</td>
                <td>@item.SegundoApellido</td>
                <td>@item.Categoria</td>
                <td>@String.Format("{0:C}", item.SalarioMensual)</td>
                <td>
                    <a asp-action="Edit" asp-route-identificacion="@item.Identificacion" class="btn btn-sm btn-primary me-1">Editar</a>
                    <a asp-action="Delete" asp-route-identificacion="@item.Identificacion" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="text-center">No hay empleados para mostrar.</td>
        </tr>
    }
    </tbody>
</table>
