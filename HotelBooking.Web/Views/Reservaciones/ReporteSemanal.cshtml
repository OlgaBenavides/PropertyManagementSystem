@model List<Reservacion>

<h2>Reporte de Reservaciones - Semana Entrante</h2>
<p class="text-muted">Reservaciones ordenadas de mayor a menor monto para la semana próxima.</p>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Habitación</th>
                <th>Fecha Inicio</th>
                <th>Fecha Salida</th>
                <th>Tarifa</th>
                <th>Descuento</th>
                <th>Monto Total</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.IDCliente</td>
                    <td>@item.IDHabitacion</td>
                    <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaSalida.ToString("dd/MM/yyyy")</td>
                    <td>@item.TarifaReservacion.ToString("C")</td>
                    <td>@item.PorcentajeDescuento %</td>
                    <td>@item.MontoTotal.ToString("C")</td>
                    <td>@item.Estado</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No hay reservaciones para la semana entrante.
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
