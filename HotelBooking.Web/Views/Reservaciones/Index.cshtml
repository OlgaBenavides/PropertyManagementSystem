@model List<Reservacion>

<h2>Reservaciones</h2>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-success">Crear nueva reservación</a>

    <form asp-action="Buscar" method="get" class="d-flex" role="search">
        <input type="text" name="codigoReservacion" class="form-control me-2" placeholder="Código reservación (ID)" />
        <input type="text" name="identificacionCliente" class="form-control me-2" placeholder="Identificación cliente (IDCliente)" />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </form>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>ID Cliente</th>
            <th>ID Habitación</th>
            <th>Fecha Inicio</th>
            <th>Fecha Salida</th>
            <th>Tarifa</th>
            <th>Monto Total</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.IDCliente</td>
                <td>@item.IDHabitacion</td>
                <td>@(item.FechaInicio.ToString("dd/MM/yyyy"))</td>
                <td>@(item.FechaSalida.ToString("dd/MM/yyyy"))</td>
                <td>@String.Format("{0:C}", item.TarifaReservacion)</td>
                <td>@String.Format("{0:C}", item.MontoTotal)</td>
                <td>@item.Estado</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-primary me-1">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="9" class="text-center">No hay reservaciones para mostrar.</td>
        </tr>
    }
    </tbody>
</table>
