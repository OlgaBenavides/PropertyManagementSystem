@model Habitacion

<h2>Crear Habitación</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="NumeroHabitacion" class="form-label"></label>
            <input asp-for="NumeroHabitacion" type="number" class="form-control" />
            <span asp-validation-for="NumeroHabitacion" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="TipoHabitacion" class="form-label"></label>
            <select asp-for="TipoHabitacion" class="form-select" asp-items="@(Html.GetEnumSelectList(typeof(TipoHabitacion)))"></select>
            <span asp-validation-for="TipoHabitacion" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="TarifaPorNoche" class="form-label"></label>
            <input asp-for="TarifaPorNoche" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="TarifaPorNoche" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="form-check">
                <input asp-for="TvSatelital" class="form-check-input" type="checkbox" />
                <label asp-for="TvSatelital" class="form-check-label"></label>
            </div>
            <span asp-validation-for="TvSatelital" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="PendientesMantenimiento" class="form-label"></label>
            <textarea asp-for="PendientesMantenimiento" class="form-control" rows="3"></textarea>
            <span asp-validation-for="PendientesMantenimiento" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
    </div>
</form>
