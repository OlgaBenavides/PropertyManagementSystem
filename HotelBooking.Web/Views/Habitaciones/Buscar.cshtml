@model Habitacion?

<h2>Buscar Habitación</h2>

@if (Model != null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Número de habitación</dt>
                <dd class="col-sm-9">@Model.NumeroHabitacion</dd>

                <dt class="col-sm-3">Tipo de habitación</dt>
                <dd class="col-sm-9">@Model.TipoHabitacion</dd>

                <dt class="col-sm-3">Tarifa por noche</dt>
                <dd class="col-sm-9">@String.Format("{0:C}", Model.TarifaPorNoche)</dd>

                <dt class="col-sm-3">TV Satelital</dt>
                <dd class="col-sm-9">@(Model.TvSatelital ? "Sí" : "No")</dd>

                <dt class="col-sm-3">Pendientes de mantenimiento</dt>
                <dd class="col-sm-9">@Model.PendientesMantenimiento</dd>
            </dl>

            <a asp-action="Edit" asp-route-numeroHabitacion="@Model.NumeroHabitacion" class="btn btn-primary me-2">Editar</a>
            <a asp-action="Delete" asp-route-numeroHabitacion="@Model.NumeroHabitacion" class="btn btn-danger">Eliminar</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No se encontró ninguna habitación con ese número.
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
